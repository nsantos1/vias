# Copie para .env e preencha. Nunca suba o .env para o Git.
# Banco Oracle da FIAP (o usuario e o seu RM, ex.: rm555555)
DB_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL
DB_USER=rm000000
DB_PASS=sua_senha
# Origens do front-end (Next.js) separadas por virgula
CORS_ORIGENS=http://localhost:3000
# false = nao criar tabelas/carga (usar quando o schema ja foi criado pela frente Oracle)
FLYWAY_ENABLED=true
