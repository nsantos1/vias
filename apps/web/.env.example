# Copie para .env.local (que não vai para o Git) e ajuste o endereço.
#
# Atenção: toda variável NEXT_PUBLIC_ é embutida no JavaScript enviado ao navegador
# no momento do build. Nunca coloque senha, token ou chave aqui.

# URL base da API Java, já com o prefixo /api.
# Desenvolvimento: a API do Raphael roda na porta 8080.
NEXT_PUBLIC_API_URL=http://localhost:8080/api
