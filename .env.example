# Copie para .env e preencha. O .env nunca vai para o Git.

# --- Banco Oracle da FIAP (os mesmos dados da conexão no SQL Developer) ---
ORACLE_USER=
# Entre aspas duplas, para não quebrar se a senha tiver # ou espaço
ORACLE_PASSWORD=""
# Se a conexão no SQL Developer usa "Nome do serviço":
#   ORACLE_DSN=host:porta/nome_do_servico
# Se usa "SID", em uma linha só:
#   ORACLE_DSN=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=host)(PORT=porta))(CONNECT_DATA=(SID=seu_sid)))
ORACLE_DSN=
# Usuário da FIAP dono das tabelas do projeto (o do Raphael). O ETL grava em DONO.TABELA.
ORACLE_ESQUEMA_TABELAS=

# --- CNES: API de dados abertos da Saúde (pública, sem cadastro) ---
# Município da cidade piloto. O CNES usa o código do IBGE com 6 dígitos (São Paulo: 355030).
VIAS_MUNICIPIO_IBGE=355030

# --- SPTrans: API Olho Vivo (cadastro na área de desenvolvedores da SPTrans) ---
OLHOVIVO_TOKEN=

# --- Google Routes API (Google Cloud) ---
GOOGLE_ROUTES_API_KEY=

# --- Endereços dos serviços internos em desenvolvimento ---
OTP_URL=http://localhost:8081
IA_URL=http://localhost:8000
